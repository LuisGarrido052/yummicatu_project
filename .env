# ========================================================
# Yummi Catu - Variables de Entorno (python-dotenv)
# Evaluación 2: Configuración de Base de Datos MySQL (XAMPP)
# ========================================================

# Modo de depuración (True para desarrollo)
DEBUG=True

# Clave secreta criptográfica de Django
SECRET_KEY=django-insecure-yummicatu-reposteria-artesanal-super-secret-key-2026

# Conmutador de motor: False para usar MySQL (XAMPP obligatorio Evaluación 2)
USE_SQLITE=False

# Configuración de Base de Datos MySQL / MariaDB en XAMPP
DB_ENGINE=django.db.backends.mysql
DB_NAME=yummicatu_db
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
