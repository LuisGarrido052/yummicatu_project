# ========================================================
# Yummi Catu - Plantilla de Variables de Entorno (.env.example)
# Conexión oficial a MySQL / MariaDB en XAMPP
# ========================================================

DEBUG=True
SECRET_KEY=django-insecure-yummicatu-reposteria-artesanal-super-secret-key-2026

# Conmutador de motor: False para usar MySQL (XAMPP obligatorio Evaluación 2)
USE_SQLITE=False

# Configuración de Base de Datos MySQL / MariaDB en XAMPP
DB_ENGINE=django.db.backends.mysql
DB_NAME=yummicatu_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
