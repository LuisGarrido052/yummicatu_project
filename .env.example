# ==========================================================
# Yummi Catu - Variables de entorno
# Copia este archivo como .env y completa los valores.
# El archivo .env NO se sube al repositorio (ver .gitignore).
# ==========================================================

# Clave secreta de Django. Genera una propia con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# True solo en desarrollo
DEBUG=True

# Dominios permitidos, separados por coma
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos MySQL / MariaDB (XAMPP)
DB_NAME=yummicatu_db
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
